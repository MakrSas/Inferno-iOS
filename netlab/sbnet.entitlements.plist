<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>platform-application</key><true/>
  <key>com.apple.private.security.no-container</key><true/>
  <!-- Without this SpringBoard drops the override and logs
       "Only entitled processes may set status bar override data". -->
  <key>com.apple.UIKit.status-bar-override-allow</key><true/>
  <key>com.apple.security.exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.UIKit.statusbarserver</string>
  </array>
</dict>
</plist>
