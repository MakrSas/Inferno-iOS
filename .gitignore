# ── Гостевая система: не наше и не для публикации ──────────────────────────
#
# Прошивки, ключи, тикеты и образы дисков Apple. Их собирают сами по гайду
# ChefKiss; здесь их нет и не будет.
stage/
airdrop/
transfer/
InfernoData/
AppleSEPROM-*
*.im4p
*.img4
*_ticket.der
*.trustcache
kernelcache*
DeviceTree*

# Диски и их части
*.qcow2
*.dmg
root
firmware
syscfg
ctrl_bits
nvram
effaceable
panic_log
sep_nvram
sep_ssc

# ── Джейлбрейк-бутстрап: чужие архивы ──────────────────────────────────────
#
# Strap от checkra1n и Cydia от bingner. Скачиваются по ссылкам из гайда,
# перевыкладывать их мы не вправе.
netlab/strap.tar.lzma
netlab/cydia.tar.lzma
netlab/launchd.plist.orig
netlab/L/

# ── Состояние опытов ───────────────────────────────────────────────────────
#
# Копии дисков, оверлеи и всё, что накопили прогоны на стенде.
netlab/run-app/
netlab/state/
netlab/state-configured/
# Записи прогонов — полезны, пока идёт работа, но это не исходники.
netlab/*.log
netlab/*.txt
# Подписанные помощники для гостя: собираются из соседних .m/.c одной командой.
netlab/nsio-ent
netlab/beep
netlab/rio
netlab/sysnd
run/
logs/
repro-logs/
*.serial
*.serial.keep
*.stdout

# ── Сборка ─────────────────────────────────────────────────────────────────
build/
build-macos/
.build/
prefix/
*.ipa
*.dylib
*.o
*.a
Payload/

# Ставится сборочным скриптом, отметка времени — не исходник.
app/Sources/BuildInfo.swift

# Создаётся make-cross-file.sh: пути к SDK и к зависимостям у каждого свои.
cross-ios-arm64.txt

# ── Форк эмулятора ─────────────────────────────────────────────────────────
#
# Отдельный репозиторий со своей историей — здесь он лежит рядом только для
# удобства сборки. См. README про то, откуда его брать.
inferno-src/
# Второе дерево QEMU, для опытов с вибрацией. Тоже отдельный клон.
inferno-haptics/

# Python
__pycache__/
*.pyc

# ── Рабочие записки ────────────────────────────────────────────────────────
#
# Скрыто только то, что не поможет никому, кроме нас: задания, написанные
# агентам, и предок нынешнего README. Разборы, грабли и список работ остаются —
# без них помочь в разработке нельзя.
HAPTICS-PROMPT.md
INVESTIGATION-PROMPT.md
README-iOS.md

# Патчи к эмулятору — их место в форке, здесь они были бы вторым источником
# правды, который непременно разойдётся с первым.
*.patch

# ── Ссылки и местные инструменты ───────────────────────────────────────────
#
# Символические ссылки на соседние деревья: у клонировавшего их некуда вести.
ios
ios-app
pixel

