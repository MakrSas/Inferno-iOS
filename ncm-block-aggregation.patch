+static NCMFrame* tx_pop(AppleNCMHostState* s)
+{
+    NCMFrame* frame;
+
+    QEMU_LOCK_GUARD(&s->tx_lock);
+    frame = s->tx_head;
+    if (frame != NULL) {
+        s->tx_head = frame->next;
+        if (s->tx_head == NULL) { s->tx_tail = NULL; }
+        s->tx_count--;
+    }
+    return frame;
+}
